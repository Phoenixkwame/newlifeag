# Copy this file to .env.local for reference and set real values as actual
# environment variables before deploying (this project doesn't load .env
# files automatically - it reads from the real environment via os.environ).

DJANGO_SECRET_KEY=generate-a-real-random-key-for-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Provided automatically by most hosts (Render, Railway, Heroku) when you
# attach a managed Postgres database. Leave unset locally to keep using SQLite.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Flutterwave - get test keys at https://dashboard.flutterwave.com
# (Settings > API Keys). Leave both blank to keep giving in manual/pending mode.
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
# Any long random string - paste the same value into Flutterwave's
# Settings > Webhooks "Secret hash", with URL https://yourdomain.com/give/webhook/
FLUTTERWAVE_WEBHOOK_HASH=choose-a-long-random-string

# SMS (Hubtel) - an extra channel alongside email for RSVP/volunteer
# confirmations and pending-gift alerts. Leave all three blank to keep SMS
# off entirely. Get credentials at https://hubtel.com (create a Quick
# SMS/SMS API app). HUBTEL_SENDER_ID is your approved "from" name (max 11
# characters).
HUBTEL_CLIENT_ID=your-hubtel-client-id
HUBTEL_CLIENT_SECRET=your-hubtel-client-secret
HUBTEL_SENDER_ID=NewlifeAG

# Required for inbound SMS. Configure the provider/trusted gateway to send
# X-SMS-Webhook-Token with this secret on POST requests over HTTPS.
# Unset disables inbound SMS (503); GET and unsigned requests are rejected.
SMS_WEBHOOK_TOKEN=

# Increase after verifying HTTPS works across your production domain.
DJANGO_SECURE_HSTS_SECONDS=3600

# Email (used for password reset links). Leave unset locally - reset emails
# just print to your terminal while DJANGO_DEBUG=True. Example values for
# Gmail SMTP (use an app password, not your real password):
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@newlifeag.org

# Turn on real online payments on the Give page (needs the Flutterwave keys
# above too). Leave False to keep recording gifts as pending for follow-up.
GIVING_ONLINE_PAYMENTS=False
